<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StatisticsTable"></style>

    <style name="StatisticsTable.LayoutWidth">
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="StatisticsTable.TextView" parent="TextAppearance.Minor">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="StatisticsTable.TextView.Label">
        <item name="android:padding">8dp</item>
    </style>

    <style name="StatisticsTable.TextView.Value">
        <item name="android:padding">8dp</item>
        <item name="android:gravity">right</item>
        <item name="android:text">0</item>
    </style>
</resources>
