<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:stretchColumns="1"
    android:background="@color/statistics_table_background">

    <TableRow>
        <TextView
            android:id="@+id/month_label"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:text="@string/month_statistics_header" />
        <TextView
            android:id="@+id/month_value"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:gravity="right"
            android:text="0" />
    </TableRow>

    <TableRow>
        <TextView
            android:id="@+id/week_label"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:text="@string/week_statistics_header" />
        <TextView
            android:id="@+id/week_value"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:gravity="right"
            android:text="0" />
    </TableRow>

    <TableRow>
        <TextView
            android:id="@+id/day_label"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:text="@string/day_statistics_header" />
        <TextView
            android:id="@+id/day_value"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:gravity="right"
            android:text="0" />
    </TableRow>

    <TableRow>
        <TextView
            android:id="@+id/minute_label"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:text="@string/minute_statistics_header" />
        <TextView
            android:id="@+id/minute_value"
            style="@style/BlackTextBase.Minor"
            android:padding="8dp"
            android:gravity="right"
            android:text="0" />
    </TableRow>

</TableLayout>